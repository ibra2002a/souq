rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) { return request.auth != null && request.auth.uid == uid; }
    function okName() { return request.resource.data.name is string && request.resource.data.name.size() <= 40; }
    function okNum(f) { return request.resource.data[f] is number && request.resource.data[f] >= 0; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /saves/{uid} {
      allow read, delete: if signedIn(uid);
      allow write: if signedIn(uid) && request.resource.data.keys().hasOnly(['state', 'updated']);
    }

    // Anti-cheat without a server: worth on the leaderboard may not grow faster than a generous curve
    // measured from the player's first entry (createdAt): 100,000,000 × 10^(1.5 × hours played).
    function cap(t0) {
      let el = request.time.toMillis() - t0 - 60000;
      return el <= 0 ? 100000000 : 100000000 * math.pow(10, 1.5 * el / 3600000);
    }
    function fresh(t) { return t is number && t > request.time.toMillis() - 120000 && t < request.time.toMillis() + 120000; }

    match /board/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid);
      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'worth', 'earned', 'ts', 'createdAt'])
        && okName() && okNum('worth') && okNum('earned') && fresh(request.resource.data.ts)
        && fresh(request.resource.data.createdAt)
        && request.resource.data.worth <= cap(request.resource.data.createdAt)
        && request.resource.data.earned <= cap(request.resource.data.createdAt);
      allow update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'worth', 'earned', 'ts', 'createdAt'])
        && okName() && okNum('worth') && okNum('earned') && fresh(request.resource.data.ts)
        && (
          // normal update: the start time never changes
          (('createdAt' in resource.data) && request.resource.data.createdAt == resource.data.createdAt)
          // older entries from before this rule get a start time of now
          || (!('createdAt' in resource.data) && fresh(request.resource.data.createdAt))
        )
        && request.resource.data.worth <= cap(request.resource.data.createdAt)
        && request.resource.data.earned <= cap(request.resource.data.createdAt);
    }

    match /seasons/{season}/players/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid);
      allow write: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'score', 'worth', 'ts'])
        && okName() && okNum('score') && okNum('worth') && fresh(request.resource.data.ts)
        && exists(/databases/$(database)/documents/board/$(uid))
        && request.resource.data.worth <= get(/databases/$(database)/documents/board/$(uid)).data.worth
        && request.resource.data.score <= request.resource.data.worth;
    }

    match /market/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'asset', 'qty', 'price', 'cost', 'ts', 'status'])
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.sellerName is string && request.resource.data.sellerName.size() <= 40
        && request.resource.data.asset in ['usd', 'gold', 'wheat', 'oil', 'cement', 'tel']
        && request.resource.data.qty is int && request.resource.data.qty > 0
        && request.resource.data.price is number && request.resource.data.price > 0;
      allow update: if request.auth != null && (
          (resource.data.status == 'open' && request.auth.uid != resource.data.seller
            && request.resource.data.status == 'sold' && request.resource.data.buyer == request.auth.uid
            && changed().hasOnly(['status', 'buyer', 'buyerName', 'soldAt']))
        || (resource.data.seller == request.auth.uid && resource.data.status == 'open'
            && request.resource.data.status == 'cancelled' && changed().hasOnly(['status']))
        || (resource.data.seller == request.auth.uid && resource.data.status == 'sold'
            && request.resource.data.status == 'paid' && changed().hasOnly(['status'])));
      allow delete: if request.auth != null && resource.data.seller == request.auth.uid
        && resource.data.status in ['paid', 'cancelled'];
    }

    match /auctions/{slot} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['item', 'highBid', 'highBidder', 'highName', 'endsAt', 'bids', 'claimed'])
        && request.time.toMillis() >= int(slot) * 10800000
        && request.time.toMillis() < int(slot) * 10800000 + 900000
        && request.resource.data.endsAt == int(slot) * 10800000 + 900000
        && request.resource.data.item == int(slot) % 6
        && request.resource.data.highBidder == request.auth.uid
        && request.resource.data.highBid is number && request.resource.data.highBid >= 1000000
        && request.resource.data.highName is string && request.resource.data.highName.size() <= 40
        && request.resource.data.bids == 1 && request.resource.data.claimed == false;
      allow update: if request.auth != null && (
          (request.time.toMillis() < resource.data.endsAt
            && changed().hasOnly(['highBid', 'highBidder', 'highName', 'endsAt', 'bids'])
            && request.resource.data.highBidder == request.auth.uid
            && resource.data.highBidder != request.auth.uid
            && request.resource.data.highBid >= resource.data.highBid * 1.05
            && request.resource.data.bids == resource.data.bids + 1
            && request.resource.data.highName is string && request.resource.data.highName.size() <= 40
            && (request.resource.data.endsAt == resource.data.endsAt
              || (request.resource.data.endsAt > resource.data.endsAt
                  && request.resource.data.endsAt <= request.time.toMillis() + 65000)))
        || (request.time.toMillis() >= resource.data.endsAt
            && resource.data.highBidder == request.auth.uid
            && resource.data.claimed == false && request.resource.data.claimed == true
            && changed().hasOnly(['claimed'])));
    }

    match /chat/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 120000
        && request.resource.data.ts < request.time.toMillis() + 120000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /alliances/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'worth', 'total', 'ts'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.worth.keys().hasOnly([request.auth.uid])
        && request.resource.data.worth[request.auth.uid] <= 100000000
        && request.resource.data.total is number;
      allow update: if request.auth != null && (
          // a member updates their own worth
          (request.auth.uid in resource.data.members
            && changed().hasOnly(['worth', 'total'])
            && request.resource.data.worth.diff(resource.data.worth).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.worth[request.auth.uid] <= get(/databases/$(database)/documents/board/$(request.auth.uid)).data.worth)
          // someone joins
        || (!(request.auth.uid in resource.data.members) && resource.data.members.size() < 5
            && changed().hasOnly(['members', 'names', 'worth', 'total'])
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.worth[request.auth.uid] <= get(/databases/$(database)/documents/board/$(request.auth.uid)).data.worth
            && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.worth.diff(resource.data.worth).affectedKeys().hasOnly([request.auth.uid]))
          // a member leaves
        || (request.auth.uid in resource.data.members
            && changed().hasOnly(['members', 'names', 'worth', 'total'])
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.worth.diff(resource.data.worth).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if request.auth != null && resource.data.members == [request.auth.uid];
    }

    match /duels/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'aName', 'b', 'bName', 'status', 'start', 'end', 'aScore', 'bScore', 'ts'])
        && request.resource.data.a == request.auth.uid && request.resource.data.b == null
        && request.resource.data.status == 'open'
        && request.resource.data.aScore == 1000000 && request.resource.data.bScore == 1000000
        && request.resource.data.aName is string && request.resource.data.aName.size() <= 40;
      allow update: if request.auth != null && (
          // the challenger joins
          (resource.data.status == 'open' && resource.data.b == null && request.auth.uid != resource.data.a
            && changed().hasOnly(['b', 'bName', 'status', 'start', 'end'])
            && request.resource.data.b == request.auth.uid && request.resource.data.status == 'live'
            && request.resource.data.bName is string && request.resource.data.bName.size() <= 40
            && request.resource.data.start > request.time.toMillis() - 30000
            && request.resource.data.start < request.time.toMillis() + 30000
            && request.resource.data.end == request.resource.data.start + 300000)
          // each player reports only their own score while the duel runs
        || (resource.data.status == 'live' && request.time.toMillis() < resource.data.end + 20000
            && ((request.auth.uid == resource.data.a && changed().hasOnly(['aScore'])
                 && request.resource.data.aScore is number && request.resource.data.aScore >= 0 && request.resource.data.aScore <= 100000000)
             || (request.auth.uid == resource.data.b && changed().hasOnly(['bScore'])
                 && request.resource.data.bScore is number && request.resource.data.bScore >= 0 && request.resource.data.bScore <= 100000000)))
          // either player closes it after the end
        || (resource.data.status == 'live' && request.time.toMillis() >= resource.data.end
            && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b)
            && changed().hasOnly(['status']) && request.resource.data.status == 'done'));
      allow delete: if request.auth != null && resource.data.a == request.auth.uid && resource.data.status == 'open';
    }

    match /refs/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == resource.data.by);
      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['by', 'name', 'ts', 'paid'])
        && request.resource.data.by is string && request.resource.data.by != uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.paid == false;
      allow update: if request.auth != null && resource.data.by == request.auth.uid
        && resource.data.paid == false && request.resource.data.paid == true
        && changed().hasOnly(['paid']);
    }
  }
}
