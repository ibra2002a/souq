rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) { return request.auth != null && request.auth.uid == uid; }
    function okName() { return request.resource.data.name is string && request.resource.data.name.size() <= 40; }
    function okNum(f) { return request.resource.data[f] is number && request.resource.data[f] >= 0; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /saves/{uid} {
      allow read, delete: if signedIn(uid);
      allow write: if signedIn(uid) && request.resource.data.keys().hasOnly(['state', 'updated']);
    }

    // Anti-cheat without a server: worth on the leaderboard may not grow faster than a generous curve
    // measured from the player's first entry (createdAt): 100,000,000 × 10^(1.5 × hours played).
    function cap(t0) {
      let el = request.time.toMillis() - t0 - 60000;
      return el <= 0 ? 100000000 : 100000000 * math.pow(10, 1.5 * el / 3600000);
    }
    function fresh(t) { return t is number && t > request.time.toMillis() - 120000 && t < request.time.toMillis() + 120000; }
    function boardWorth(u) {
      return exists(/databases/$(database)/documents/board/$(u)) ? get(/databases/$(database)/documents/board/$(u)).data.worth : 0;
    }
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function otherOf(m) { return m[0] == request.auth.uid ? m[1] : m[0]; }
    function dueOk(d) { return request.resource.data.due >= request.time.toMillis() + d - 120000 && request.resource.data.due <= request.time.toMillis() + d + 120000; }

    match /board/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid);
      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'worth', 'earned', 'ts', 'createdAt'])
        && okName() && okNum('worth') && okNum('earned') && fresh(request.resource.data.ts)
        && fresh(request.resource.data.createdAt)
        && request.resource.data.worth <= cap(request.resource.data.createdAt)
        && request.resource.data.earned <= cap(request.resource.data.createdAt);
      allow update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'worth', 'earned', 'ts', 'createdAt'])
        && okName() && okNum('worth') && okNum('earned') && fresh(request.resource.data.ts)
        && (
          // normal update: the start time never changes
          (('createdAt' in resource.data) && request.resource.data.createdAt == resource.data.createdAt)
          // older entries from before this rule get a start time of now
          || (!('createdAt' in resource.data) && fresh(request.resource.data.createdAt))
        )
        && request.resource.data.worth <= cap(request.resource.data.createdAt)
        && request.resource.data.earned <= cap(request.resource.data.createdAt);
    }

    match /seasons/{season}/players/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid);
      allow write: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'score', 'worth', 'ts'])
        && okName() && okNum('score') && okNum('worth') && fresh(request.resource.data.ts)
        && exists(/databases/$(database)/documents/board/$(uid))
        && request.resource.data.worth <= get(/databases/$(database)/documents/board/$(uid)).data.worth
        && request.resource.data.score <= request.resource.data.worth;
    }

    // Public player profiles (photo, name, title). Phone numbers stay in the private save, never here.
    match /profiles/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid);
      allow write: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'title', 'rank', 'worth', 'ach', 'rare', 'wins', 'pid', 'late', 'joined', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 70000
        && (request.resource.data.avatar == '' || request.resource.data.avatar.matches('^(data:image/(jpeg|png|webp);base64,|https://).*'))
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.rank is int && request.resource.data.rank >= 0 && request.resource.data.rank <= 5
        && request.resource.data.worth is number && request.resource.data.worth >= 0
        && fresh(request.resource.data.ts);
    }

    // Account numbers (SQ-XXXXXX) that point to a player.
    match /ids/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && code.matches('^SQ[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'ts']) && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Transfers of virtual dinars between players. A transfer can never exceed the sender's leaderboard worth.
    match /transfers/{id} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'amt', 'note', 'ts', 'status'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'sent'
        && request.resource.data.amt is number && request.resource.data.amt >= 1
        && request.resource.data.amt <= boardWorth(request.auth.uid)
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 24
        && request.resource.data.note is string && request.resource.data.note.size() <= 60
        && fresh(request.resource.data.ts);
      allow update: if request.auth != null && resource.data.status == 'sent' && changed().hasOnly(['status'])
        && ((request.auth.uid == resource.data.to && request.resource.data.status == 'claimed')
         || (request.auth.uid == resource.data.from && request.resource.data.status == 'cancelled'));
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && resource.data.status in ['claimed', 'cancelled'];
    }

    // Loans between players.
    match /loans/{id} {
      allow read: if request.auth != null && (resource.data.lender == request.auth.uid || resource.data.borrower == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['lender', 'lenderName', 'borrower', 'borrowerName', 'amt', 'owe', 'rate', 'dur', 'due', 'got', 'paid', 'ts', 'status'])
        && request.resource.data.lender is string && request.resource.data.borrower is string
        && request.resource.data.lender != request.resource.data.borrower
        && request.resource.data.amt is number && request.resource.data.amt >= 1000
        && request.resource.data.rate is number && request.resource.data.rate >= 0 && request.resource.data.rate <= 0.2
        && request.resource.data.owe >= request.resource.data.amt && request.resource.data.owe <= request.resource.data.amt * 1.2 + 1
        && request.resource.data.dur in [3600000, 21600000, 86400000]
        && request.resource.data.due == 0 && request.resource.data.got == false && request.resource.data.paid == 0
        && request.resource.data.lenderName is string && request.resource.data.lenderName.size() <= 24
        && request.resource.data.borrowerName is string && request.resource.data.borrowerName.size() <= 24
        && fresh(request.resource.data.ts)
        && ((request.resource.data.status == 'offered' && request.resource.data.lender == request.auth.uid
             && request.resource.data.amt <= boardWorth(request.auth.uid))
         || (request.resource.data.status == 'requested' && request.resource.data.borrower == request.auth.uid));
      allow update: if request.auth != null && (
          // the borrower accepts an offer and receives the money
          (resource.data.status == 'offered' && request.auth.uid == resource.data.borrower
            && request.resource.data.status == 'active' && request.resource.data.got == true
            && changed().hasOnly(['status', 'got', 'due']) && dueOk(resource.data.dur))
          // the borrower declines an offer (the lender then takes the escrow back)
       || (resource.data.status == 'offered' && request.auth.uid == resource.data.borrower
            && request.resource.data.status == 'declined' && changed().hasOnly(['status']))
          // the lender funds a request
       || (resource.data.status == 'requested' && request.auth.uid == resource.data.lender
            && request.resource.data.status == 'active' && changed().hasOnly(['status', 'due'])
            && resource.data.amt <= boardWorth(request.auth.uid) && dueOk(resource.data.dur))
          // the borrower collects money from a funded request
       || (resource.data.status == 'active' && resource.data.got == false && request.auth.uid == resource.data.borrower
            && changed().hasOnly(['got']) && request.resource.data.got == true)
          // the borrower repays at least what is owed
       || (resource.data.status == 'active' && resource.data.got == true && request.auth.uid == resource.data.borrower
            && request.resource.data.status == 'repaid' && changed().hasOnly(['status', 'paid', 'repaidAt'])
            && request.resource.data.paid is number && request.resource.data.paid >= resource.data.owe));
      allow delete: if request.auth != null && (
          (request.auth.uid == resource.data.lender && resource.data.status in ['offered', 'requested', 'repaid', 'declined'])
       || (request.auth.uid == resource.data.borrower && resource.data.status == 'requested'));
    }

    // Friend requests: id is "<from>_<to>".
    match /friendReqs/{rid} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && rid == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 24
        && fresh(request.resource.data.ts);
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // A friendship exists only after the other player sent a request that this player accepts.
    match /friends/{fid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'names', 'ts', 'last', 'lastTs', 'lastBy'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && fid == pair(request.resource.data.members[0], request.resource.data.members[1])
        && exists(/databases/$(database)/documents/friendReqs/$(otherOf(request.resource.data.members) + '_' + request.auth.uid))
        && request.resource.data.last == '' && request.resource.data.lastBy == '' && request.resource.data.lastTs == 0;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastTs', 'lastBy'])
        && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.last is string && request.resource.data.last.size() <= 80;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Private messages, readable only by the two friends.
    match /dms/{fid}/msgs/{mid} {
      function isMember() { return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/friends/$(fid)).data.members; }
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'ts', 'kind', 'ref'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
        && request.resource.data.kind in ['text', 'duel', 'money']
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
        && fresh(request.resource.data.ts);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if signedIn(uid) && request.resource.data.keys().hasOnly(['ts']) && fresh(request.resource.data.ts);
      allow delete: if signedIn(uid);
    }

    // Voice calls between friends (WebRTC signalling).
    match /calls/{cid} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'status', 'offer', 'answer', 'ts'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer is string && request.resource.data.offer.size() < 20000
        && request.resource.data.answer == ''
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && fresh(request.resource.data.ts)
        && exists(/databases/$(database)/documents/friends/$(pair(request.auth.uid, request.resource.data.to)));
      allow update: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer'])
        && request.resource.data.status in ['ringing', 'live', 'declined', 'ended']
        && request.resource.data.answer is string && request.resource.data.answer.size() < 20000;
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      match /cand/{x} {
        function party() {
          let c = get(/databases/$(database)/documents/calls/$(cid)).data;
          return request.auth != null && (c.from == request.auth.uid || c.to == request.auth.uid);
        }
        allow read: if party();
        allow create: if party()
          && request.resource.data.keys().hasOnly(['who', 'c', 'ts'])
          && request.resource.data.who in ['a', 'b']
          && request.resource.data.c is string && request.resource.data.c.size() < 3000;
      }
    }

    match /market/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'asset', 'qty', 'price', 'cost', 'ts', 'status'])
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.sellerName is string && request.resource.data.sellerName.size() <= 40
        && request.resource.data.asset in ['usd', 'gold', 'wheat', 'oil', 'cement', 'tel']
        && request.resource.data.qty is int && request.resource.data.qty > 0
        && request.resource.data.price is number && request.resource.data.price > 0;
      allow update: if request.auth != null && (
          (resource.data.status == 'open' && request.auth.uid != resource.data.seller
            && request.resource.data.status == 'sold' && request.resource.data.buyer == request.auth.uid
            && changed().hasOnly(['status', 'buyer', 'buyerName', 'soldAt']))
        || (resource.data.seller == request.auth.uid && resource.data.status == 'open'
            && request.resource.data.status == 'cancelled' && changed().hasOnly(['status']))
        || (resource.data.seller == request.auth.uid && resource.data.status == 'sold'
            && request.resource.data.status == 'paid' && changed().hasOnly(['status'])));
      allow delete: if request.auth != null && resource.data.seller == request.auth.uid
        && resource.data.status in ['paid', 'cancelled'];
    }

    match /auctions/{slot} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['item', 'highBid', 'highBidder', 'highName', 'endsAt', 'bids', 'claimed'])
        && request.time.toMillis() >= int(slot) * 10800000
        && request.time.toMillis() < int(slot) * 10800000 + 900000
        && request.resource.data.endsAt == int(slot) * 10800000 + 900000
        && request.resource.data.item == int(slot) % 6
        && request.resource.data.highBidder == request.auth.uid
        && request.resource.data.highBid is number && request.resource.data.highBid >= 1000000
        && request.resource.data.highName is string && request.resource.data.highName.size() <= 40
        && request.resource.data.bids == 1 && request.resource.data.claimed == false;
      allow update: if request.auth != null && (
          (request.time.toMillis() < resource.data.endsAt
            && changed().hasOnly(['highBid', 'highBidder', 'highName', 'endsAt', 'bids'])
            && request.resource.data.highBidder == request.auth.uid
            && resource.data.highBidder != request.auth.uid
            && request.resource.data.highBid >= resource.data.highBid * 1.05
            && request.resource.data.bids == resource.data.bids + 1
            && request.resource.data.highName is string && request.resource.data.highName.size() <= 40
            && (request.resource.data.endsAt == resource.data.endsAt
              || (request.resource.data.endsAt > resource.data.endsAt
                  && request.resource.data.endsAt <= request.time.toMillis() + 65000)))
        || (request.time.toMillis() >= resource.data.endsAt
            && resource.data.highBidder == request.auth.uid
            && resource.data.claimed == false && request.resource.data.claimed == true
            && changed().hasOnly(['claimed'])));
    }

    match /chat/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 120000
        && request.resource.data.ts < request.time.toMillis() + 120000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /alliances/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'worth', 'total', 'ts'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.worth.keys().hasOnly([request.auth.uid])
        && request.resource.data.worth[request.auth.uid] <= 100000000
        && request.resource.data.total is number;
      allow update: if request.auth != null && (
          // a member updates their own worth
          (request.auth.uid in resource.data.members
            && changed().hasOnly(['worth', 'total'])
            && request.resource.data.worth.diff(resource.data.worth).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.worth[request.auth.uid] <= get(/databases/$(database)/documents/board/$(request.auth.uid)).data.worth)
          // someone joins
        || (!(request.auth.uid in resource.data.members) && resource.data.members.size() < 5
            && changed().hasOnly(['members', 'names', 'worth', 'total'])
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.worth[request.auth.uid] <= get(/databases/$(database)/documents/board/$(request.auth.uid)).data.worth
            && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.worth.diff(resource.data.worth).affectedKeys().hasOnly([request.auth.uid]))
          // a member leaves
        || (request.auth.uid in resource.data.members
            && changed().hasOnly(['members', 'names', 'worth', 'total'])
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.worth.diff(resource.data.worth).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if request.auth != null && resource.data.members == [request.auth.uid];
    }

    match /duels/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'aName', 'b', 'bName', 'status', 'start', 'end', 'aScore', 'bScore', 'ts'])
        && request.resource.data.a == request.auth.uid && request.resource.data.b == null
        && request.resource.data.status == 'open'
        && request.resource.data.aScore == 1000000 && request.resource.data.bScore == 1000000
        && request.resource.data.aName is string && request.resource.data.aName.size() <= 40;
      allow update: if request.auth != null && (
          // the challenger joins
          (resource.data.status == 'open' && resource.data.b == null && request.auth.uid != resource.data.a
            && changed().hasOnly(['b', 'bName', 'status', 'start', 'end'])
            && request.resource.data.b == request.auth.uid && request.resource.data.status == 'live'
            && request.resource.data.bName is string && request.resource.data.bName.size() <= 40
            && request.resource.data.start > request.time.toMillis() - 30000
            && request.resource.data.start < request.time.toMillis() + 30000
            && request.resource.data.end == request.resource.data.start + 300000)
          // each player reports only their own score while the duel runs
        || (resource.data.status == 'live' && request.time.toMillis() < resource.data.end + 20000
            && ((request.auth.uid == resource.data.a && changed().hasOnly(['aScore'])
                 && request.resource.data.aScore is number && request.resource.data.aScore >= 0 && request.resource.data.aScore <= 100000000)
             || (request.auth.uid == resource.data.b && changed().hasOnly(['bScore'])
                 && request.resource.data.bScore is number && request.resource.data.bScore >= 0 && request.resource.data.bScore <= 100000000)))
          // either player closes it after the end
        || (resource.data.status == 'live' && request.time.toMillis() >= resource.data.end
            && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b)
            && changed().hasOnly(['status']) && request.resource.data.status == 'done'));
      allow delete: if request.auth != null && resource.data.a == request.auth.uid && resource.data.status == 'open';
    }

    match /refs/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == resource.data.by);
      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['by', 'name', 'ts', 'paid'])
        && request.resource.data.by is string && request.resource.data.by != uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.paid == false;
      allow update: if request.auth != null && resource.data.by == request.auth.uid
        && resource.data.paid == false && request.resource.data.paid == true
        && changed().hasOnly(['paid']);
    }
  }
}
