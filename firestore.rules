    match /news/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'k', 'uid', 'name', 'txt', 'amt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.k in ['auc', 'seize', 'duel', 'land', 'landSale', 'landGov', 'ipo', 'share', 'cand', 'pres', 'rank', 'trade', 'strike', 'build', 'cert', 'room', 'gift', 'roomWin', 'ludo']
        && request.resource.data.txt is string && request.resource.data.txt.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.amt is number && request.resource.data.amt >= 0
        && request.resource.data.amt <= boardWorth(request.auth.uid) * 10 + 1000000
        && fresh(request.resource.data.t);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /rooms/{rid} {
      function R() { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
      function isMem(u) { return exists(/databases/$(database)/documents/rooms/$(rid)/members/$(u)); }
      function banned(u) { return exists(/databases/$(database)/documents/rooms/$(rid)/bans/$(u)); }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'title', 'theme', 'fee', 'cap', 'ts', 'until', 'status', 'game'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'open' && request.resource.data.game == null
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 24
        && request.resource.data.theme is int && request.resource.data.theme >= 0 && request.resource.data.theme <= 4
        && request.resource.data.fee is int && request.resource.data.fee >= 0 && request.resource.data.fee <= 1000000000
        && request.resource.data.cap is int && request.resource.data.cap >= 2 && request.resource.data.cap <= 20
        && fresh(request.resource.data.ts)
        && request.resource.data.until is int && request.resource.data.until > request.time.toMillis()
        && request.resource.data.until <= request.time.toMillis() + 10920000;
      allow update: if request.auth != null && resource.data.host == request.auth.uid
        && changed().hasOnly(['game', 'status', 'until', 'title'])
        && request.resource.data.until <= resource.data.until
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.title is string && request.resource.data.title.size() <= 40;

      match /members/{uid} {
        allow read: if request.auth != null;
        allow create: if signedIn(uid) && !banned(uid)
          && R().status == 'open' && R().until > request.time.toMillis()
          && request.resource.data.keys().hasOnly(['name', 'ts', 'here', 'mic', 'pay'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.here == true && request.resource.data.mic == false
          && (uid == R().host || R().fee == 0 || paidBy(request.resource.data.pay, R().host, R().fee));
        allow update: if request.auth != null && (
            (request.auth.uid == uid && !banned(uid) && changed().hasOnly(['here', 'ts', 'mic', 'name'])
              && request.resource.data.mic is bool && request.resource.data.here is bool)
          || (request.auth.uid == R().host && changed().hasOnly(['mic']) && request.resource.data.mic == false));
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == R().host);
      }
      match /bans/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == R().host && uid != R().host;
      }
      match /msgs/{mid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && isMem(request.auth.uid) && !banned(request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'txt', 'ts', 'k', 'g', 'to', 'toName', 'amt', 'pay', 'a', 'dur'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.txt is string && request.resource.data.txt.size() <= 200
          && fresh(request.resource.data.ts)
          && request.resource.data.k in ['msg', 'gift', 'sys', 'join', 'voice']
          && (request.resource.data.k != 'voice' || (request.resource.data.a is string && request.resource.data.a.size() <= 200000
              && request.resource.data.a.matches('^data:audio/[a-z0-9.;=+-]+;base64,.*$')
              && request.resource.data.dur is number && request.resource.data.dur > 0 && request.resource.data.dur <= 16))
          && (request.resource.data.k != 'sys' || request.auth.uid == R().host)
          && (request.resource.data.k != 'gift' || (request.resource.data.g is int && request.resource.data.to is string
              && request.resource.data.toName is string && request.resource.data.toName.size() <= 24
              && request.resource.data.amt is int && request.resource.data.amt > 0
              && paidBy(request.resource.data.pay, request.resource.data.to, request.resource.data.amt)));
      }
      match /sig/{sid} {
        allow read: if request.auth != null && (resource.data.t == request.auth.uid || resource.data.f == request.auth.uid);
        allow create: if request.auth != null && isMem(request.auth.uid)
          && request.resource.data.keys().hasOnly(['f', 't', 'k', 'd', 's', 'ts'])
          && request.resource.data.f == request.auth.uid
          && request.resource.data.t is string && request.resource.data.k in ['o', 'a', 'c']
          && request.resource.data.d is string && request.resource.data.d.size() <= 20000;
        allow delete: if request.auth != null && (resource.data.t == request.auth.uid || resource.data.f == request.auth.uid);
      }
      match /ans/{aid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && isMem(request.auth.uid)
          && request.resource.data.keys().hasOnly(['g', 'k', 'a', 'uid', 'name', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.g is int && request.resource.data.k is int && request.resource.data.a is int
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && aid == string(request.resource.data.g) + '_' + string(request.resource.data.k) + '_' + request.auth.uid
          && fresh(request.resource.data.ts);
      }
    }

    match /ludo/{gid} {
      function inRoom(rid) { return exists(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid)); }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['room', 'host', 'max', 'stake', 'uids', 'names', 'status', 'turn', 'seq', 'six', 'pc', 'last', 'ts', 'winner'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.names.size() == 1 && request.resource.data.names[0] is string && request.resource.data.names[0].size() <= 24
        && request.resource.data.status == 'wait'
        && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 4
        && request.resource.data.stake is int && request.resource.data.stake >= 0 && request.resource.data.stake <= 100000000
        && request.resource.data.stake <= boardWorth(request.auth.uid)
        && request.resource.data.room is string && inRoom(request.resource.data.room)
        && fresh(request.resource.data.ts);
      allow update: if request.auth != null && (
          (resource.data.status == 'wait' && !(request.auth.uid in resource.data.uids)
            && changed().hasOnly(['uids', 'names'])
            && request.resource.data.uids.size() == resource.data.uids.size() + 1
            && request.resource.data.uids.size() <= resource.data.max
            && request.resource.data.uids[request.resource.data.uids.size() - 1] == request.auth.uid
            && request.resource.data.uids.hasAll(resource.data.uids)
            && request.resource.data.names.size() == request.resource.data.uids.size()
            && request.resource.data.names[request.resource.data.names.size() - 1] is string
            && request.resource.data.names[request.resource.data.names.size() - 1].size() <= 24
            && request.resource.data.stake <= boardWorth(request.auth.uid)
            && inRoom(resource.data.room))
        || (resource.data.status == 'wait' && request.auth.uid == resource.data.host
            && changed().hasOnly(['uids', 'names'])
            && request.resource.data.uids.size() == resource.data.uids.size() + 1
            && request.resource.data.uids.size() <= resource.data.max
            && request.resource.data.uids[request.resource.data.uids.size() - 1].matches('^bot_[a-z0-9]{1,12}$')
            && request.resource.data.uids.hasAll(resource.data.uids)
            && request.resource.data.names.size() == request.resource.data.uids.size()
            && request.resource.data.names[request.resource.data.names.size() - 1] is string
            && request.resource.data.names[request.resource.data.names.size() - 1].size() <= 24)
        || (resource.data.status == 'wait' && request.auth.uid == resource.data.host
            && changed().hasOnly(['status', 'pc', 'turn', 'seq', 'six', 'ts', 'max'])
            && ((request.resource.data.status == 'play' && resource.data.uids.size() >= 2
                 && request.resource.data.max == resource.data.uids.size()
                 && request.resource.data.pc.size() == resource.data.uids.size() * 4)
              || request.resource.data.status == 'cancel'))
        || (resource.data.status == 'play' && request.auth.uid in resource.data.uids
            && changed().hasOnly(['pc', 'seq', 'turn', 'six', 'last', 'ts', 'status', 'winner'])
            && request.resource.data.seq == resource.data.seq + 1
            && request.resource.data.status in ['play', 'done']
            && request.resource.data.pc.size() == resource.data.pc.size()
            && (request.auth.uid == resource.data.uids[resource.data.turn]
                || (resource.data.uids[resource.data.turn].matches('^bot_.*') && request.auth.uid == resource.data.host)
                || request.time.toMillis() > resource.data.ts + 20000)
            && (request.resource.data.status == 'play' || request.resource.data.winner in resource.data.uids)));
    }
    match /tables/{gid} {
      function inRoom(rid) { return exists(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid)); }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['room', 'type', 'host', 'max', 'stake', 'uids', 'names', 'status', 'turn', 'seq', 'st', 'last', 'ts', 'winner'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.names.size() == 1 && request.resource.data.names[0] is string && request.resource.data.names[0].size() <= 24
        && request.resource.data.status == 'wait'
        && request.resource.data.type in ['dom', 'tawla', 'chess', 'colors', 'tarneeb']
        && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 4
        && request.resource.data.stake is int && request.resource.data.stake >= 0 && request.resource.data.stake <= 100000000
        && request.resource.data.stake <= boardWorth(request.auth.uid)
        && request.resource.data.room is string && inRoom(request.resource.data.room)
        && fresh(request.resource.data.ts);
      allow update: if request.auth != null && (
          (resource.data.status == 'wait' && !(request.auth.uid in resource.data.uids)
            && changed().hasOnly(['uids', 'names'])
            && request.resource.data.uids.size() == resource.data.uids.size() + 1
            && request.resource.data.uids.size() <= resource.data.max
            && request.resource.data.uids[request.resource.data.uids.size() - 1] == request.auth.uid
            && request.resource.data.uids.hasAll(resource.data.uids)
            && request.resource.data.names.size() == request.resource.data.uids.size()
            && request.resource.data.names[request.resource.data.names.size() - 1] is string
            && request.resource.data.names[request.resource.data.names.size() - 1].size() <= 24
            && request.resource.data.stake <= boardWorth(request.auth.uid)
            && inRoom(resource.data.room))
        || (resource.data.status == 'wait' && request.auth.uid == resource.data.host
            && changed().hasOnly(['uids', 'names'])
            && request.resource.data.uids.size() == resource.data.uids.size() + 1
            && request.resource.data.uids.size() <= resource.data.max
            && request.resource.data.uids[request.resource.data.uids.size() - 1].matches('^bot_[a-z0-9]{1,12}$')
            && request.resource.data.uids.hasAll(resource.data.uids)
            && request.resource.data.names.size() == request.resource.data.uids.size()
            && request.resource.data.names[request.resource.data.names.size() - 1] is string
            && request.resource.data.names[request.resource.data.names.size() - 1].size() <= 24)
        || (resource.data.status == 'wait' && request.auth.uid == resource.data.host
            && changed().hasOnly(['status', 'st', 'turn', 'seq', 'ts', 'max'])
            && ((request.resource.data.status == 'play' && resource.data.uids.size() >= 2
                 && request.resource.data.max == resource.data.uids.size()
                 && request.resource.data.st is map)
              || request.resource.data.status == 'cancel'))
        || (resource.data.status == 'play' && request.auth.uid in resource.data.uids
            && changed().hasOnly(['st', 'seq', 'turn', 'last', 'ts', 'status', 'winner'])
            && request.resource.data.seq == resource.data.seq + 1
            && request.resource.data.status in ['play', 'done', 'draw']
                        && (request.auth.uid == resource.data.uids[resource.data.turn]
                || (resource.data.uids[resource.data.turn].matches('^bot_.*') && request.auth.uid == resource.data.host)
                || request.time.toMillis() > resource.data.ts + 20000)
            && (request.resource.data.status != 'done' || request.resource.data.winner in resource.data.uids)));
    }

    match /gboard/{uid} {
      allow read: if request.auth != null;
      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'xp', 'w', 'p', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 400
        && request.resource.data.w is int && request.resource.data.p is int
        && fresh(request.resource.data.ts);
      allow update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['name', 'xp', 'w', 'p', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.xp is int && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp <= resource.data.xp + 400
        && request.resource.data.w is int && request.resource.data.p is int
        && request.resource.data.ts > resource.data.ts + 30000
        && fresh(request.resource.data.ts);
    }

    match /tour/{day}/players/{uid} {
      function tourOpen() { return (request.time.toMillis() + 10800000) % 86400000 >= 75600000 && (request.time.toMillis() + 10800000) % 86400000 < 82800000; }
      allow read: if request.auth != null;
      allow create: if signedIn(uid) && tourOpen()
        && request.resource.data.keys().hasOnly(['name', 'pts', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.pts is int && request.resource.data.pts >= 1 && request.resource.data.pts <= 3
        && fresh(request.resource.data.ts);
      allow update: if signedIn(uid) && tourOpen()
        && request.resource.data.keys().hasOnly(['name', 'pts', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.pts is int && request.resource.data.pts > resource.data.pts
        && request.resource.data.pts <= resource.data.pts + 3
        && request.resource.data.ts > resource.data.ts + 60000
        && fresh(request.resource.data.ts);
    }


    match /topups/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'pid', 'gems', 'price', 'method', 'phone', 'ref', 'status', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.gems in [100, 550, 1200, 3200, 7000]
        && request.resource.data.price is int && request.resource.data.price > 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 12
        && request.resource.data.method is string && request.resource.data.method.size() <= 30
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
        && fresh(request.resource.data.ts);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'by', 'at'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid && resource.data.status == 'pending';
    }

    match /grants/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'gems', 'gold', 'note', 'ts', 'claimed', 'ref'])
        && request.resource.data.uid is string && request.resource.data.claimed == false
        && request.resource.data.gems is int && request.resource.data.gems >= 0 && request.resource.data.gems <= 100000
        && request.resource.data.gold is int && request.resource.data.gold >= 0 && request.resource.data.gold <= 10000000
        && request.resource.data.note is string && request.resource.data.note.size() <= 60;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && resource.data.claimed == false && request.resource.data.claimed == true && changed().hasOnly(['claimed']);
    }

    match /payreq/{id} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'amt', 'cur', 'note', 'status', 'ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.amt is int && request.resource.data.amt >= 1 && request.resource.data.amt <= 10000000
        && request.resource.data.cur in ['gold', 'gem'] && request.resource.data.status == 'open'
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 24
        && request.resource.data.note is string && request.resource.data.note.size() <= 60
        && fresh(request.resource.data.ts);
      allow update: if request.auth != null && resource.data.status == 'open' && changed().hasOnly(['status'])
        && ((request.auth.uid == resource.data.to && request.resource.data.status in ['paid', 'declined'])
         || (request.auth.uid == resource.data.from && request.resource.data.status == 'cancelled'));
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) && resource.data.status != 'open';
    }
  }
}
